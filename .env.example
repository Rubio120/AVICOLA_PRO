# Development-only example. Copy to .env and replace every value outside local development.
POSTGRES_DB=avicola_pro
POSTGRES_USER=avicola
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Backend session settings for local development only. The HMAC key uses unpadded URL-safe Base64 for at least 32 random bytes.
AVICOLA_SESSION_COOKIE_SECURE=false
AVICOLA_SESSION_HMAC_KEY=bG9jYWwtZGV2ZWxvcG1lbnQtb25seS1zZXNzaW9uLWhtYWMta2V5
