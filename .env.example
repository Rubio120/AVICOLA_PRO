# Development-only example. Copy to .env and replace every value outside local development.
POSTGRES_DB=avicola_pro
POSTGRES_USER=avicola
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Backend session settings for local development only. Replace the HMAC key outside local/test.
AVICOLA_SESSION_COOKIE_SECURE=false
AVICOLA_SESSION_HMAC_KEY=local-development-only-session-hmac-key-replace-before-staging
