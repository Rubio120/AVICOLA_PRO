# Development-only example. Copy to .env and replace every value outside local development.
POSTGRES_DB=avicola_pro
POSTGRES_USER=avicola
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Backend session settings for local development only. Production must generate the unpadded Base64 URL-safe HMAC key with a CSPRNG; configuration only filters known weak patterns.
AVICOLA_SESSION_COOKIE_SECURE=false
AVICOLA_SESSION_HMAC_KEY=3ZD3Evyn0jNcray1baXMzLTysArzXFrRSjRsNHN0N_o
