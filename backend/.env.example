# Development-only backend configuration. Never reuse these values in staging or production.
AVICOLA_ENVIRONMENT=local
AVICOLA_DEBUG=true
AVICOLA_LOG_LEVEL=INFO
AVICOLA_LOG_FORMAT=console
AVICOLA_DATABASE_URL=postgresql+psycopg://avicola:local-development-only@127.0.0.1:5432/avicola_pro
AVICOLA_DATABASE_COMMAND_TIMEOUT_SECONDS=5
AVICOLA_CORS_ORIGINS=["http://localhost:3000"]
AVICOLA_SESSION_COOKIE_NAME=avicola_session
AVICOLA_SESSION_COOKIE_HTTP_ONLY=true
AVICOLA_SESSION_COOKIE_SECURE=false
AVICOLA_SESSION_COOKIE_SAMESITE=lax
AVICOLA_SESSION_COOKIE_PATH=/api/v1
AVICOLA_SESSION_IDLE_TIMEOUT_SECONDS=1800
AVICOLA_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
AVICOLA_SESSION_ROTATION_INTERVAL_SECONDS=900
AVICOLA_SESSION_TOKEN_BYTES=32
AVICOLA_SESSION_TOKEN_ENTROPY_BITS=256
# Unpadded URL-safe Base64 encoding of at least 32 CSPRNG-generated bytes. The fictitious sample is rejected outside local/test.
# Configuration cannot prove cryptographic randomness; generate the production value with a CSPRNG.
AVICOLA_SESSION_HMAC_KEY=3ZD3Evyn0jNcray1baXMzLTysArzXFrRSjRsNHN0N_o
AVICOLA_CSRF_TOKEN_BYTES=32
AVICOLA_PASSWORD_MIN_LENGTH=12
AVICOLA_PASSWORD_MAX_LENGTH=128
AVICOLA_LOGIN_MAX_FAILED_ATTEMPTS=5
AVICOLA_LOGIN_LOCKOUT_SECONDS=900
AVICOLA_LOGIN_RATE_LIMIT_ATTEMPTS=5
AVICOLA_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
